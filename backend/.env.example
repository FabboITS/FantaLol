# Copia questo file in backend/.env e valorizza i segreti. Non committare mai il file .env.

# --- Django -------------------------------------------------------------------------------------
# Obbligatoria in produzione (avvio rifiutato se assente).
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://fantalol:fantalol@db:5432/fantalol
POSTGRES_PASSWORD=fantalol

# --- JWT ----------------------------------------------------------------------------------------
# Obbligatoria in produzione, almeno 32 caratteri.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Admin globale (creato all'avvio da "ensure_admin"; se assenti nessun admin viene creato) -------
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- PandaScore (calendario/risultati/roster). Senza token il sync non parte e si serve la cache ----
PANDASCORE_API_TOKEN=
PANDASCORE_API_BASE=https://api.pandascore.co

# --- Leaguepedia (statistiche per game, CC BY-SA). Bot password da Special:BotPasswords -----------
# Formato username: Utente@NomeBot. Senza credenziali l'arricchimento non parte.
LEAGUEPEDIA_BOT_USERNAME=
LEAGUEPEDIA_BOT_PASSWORD=
LEAGUEPEDIA_API_BASE=https://lol.fandom.com
LEAGUEPEDIA_ENRICH_BATCH_SIZE=10
LEAGUEPEDIA_GIVE_UP_DAYS=7
LEAGUEPEDIA_MIN_INTERVAL_SECONDS=1.0

# --- Regole e cache -----------------------------------------------------------------------------
ESPORTS_STALE_AFTER_MINUTES=90
AUCTION_SECONDS_PER_BID=15
CREDITI_INIZIALI_DEFAULT=1000
REGIONAL_DEFAULT_QUOTAZIONE=10
GUNICORN_WORKERS=3
