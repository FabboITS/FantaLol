# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=cambiami
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Con DJANGO_DEBUG attivo Django serve anche il frontend provvisorio su "/".
# Metti false per esporre solo le API.
SERVE_LOCAL_FRONTEND=false

# Password dell'admin globale creato da `seed_base_data`. Se vuota il comando
# usa l'hash BCrypt di default incluso nel codice: in produzione impostala.
DJANGO_ADMIN_PASSWORD=

# --- Database (Postgres) --------------------------------------------------
DB_NAME=fantalol
DB_USER=fantalol
DB_PASSWORD=fantalol
DB_HOST=db
DB_PORT=5432

# --- JWT ------------------------------------------------------------------
JWT_SECRET=cambiami-anche-questo
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_DAYS=7

# --- Celery / Redis -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Regole di gioco ------------------------------------------------------
LINEUP_TIMEZONE=Europe/Rome
DEFAULT_LEAGUE_CREDITS=1000
MAX_TEAMS_PER_LEAGUE=10
AUCTION_SECONDS_PER_BID=15
SPLIT_BACKFILL_FROM=2026-07-24T00:00:00+02:00

# Chiude le aste scadute alla prima lettura, senza bisogno di un worker Celery.
# Utile in locale; in produzione, con il worker attivo, puoi metterla a false.
FINALIZE_AUCTIONS_ON_READ=true

# La modalità Worlds è ancora in sviluppo: finché è true, /api/worlds/**
# risponde solo all'ADMIN globale. Metti false per aprirla a tutti.
WORLDS_IN_DEVELOPMENT=true

# --- PandaScore (calendario, stato e risultati serie) ---------------------
# Senza token il task sync_pandascore non parte: si serve solo la cache su DB.
PANDASCORE_API_TOKEN=
PANDASCORE_API_BASE=https://api.pandascore.co
PANDASCORE_TIMEOUT_SECONDS=20
PANDASCORE_PER_PAGE=100

# Allowlist leghe: CODICE:pandascore_league_id, separati da virgola.
# Aggiungi qui gli id dei tornei Worlds quando servono: nessun id sta nel codice.
SUPPORTED_PRO_LEAGUES=LEC:4198,LPL:294,LCK:293

# Torneo LEC usato dal vecchio backend, utile come riferimento per
# `import_pro_rosters --tournament-id`. Da verificare contro l'API reale.
# LEC_TOURNAMENT_ID=21344

# --- Leaguepedia (box score per game, CC BY-SA 3.0) -----------------------
# Senza credenziali il task enrich_leaguepedia non parte: si servono solo i
# game già arricchiti.
LEAGUEPEDIA_BOT_USERNAME=
LEAGUEPEDIA_BOT_PASSWORD=
LEAGUEPEDIA_API_BASE=https://lol.fandom.com
LEAGUEPEDIA_MIN_INTERVAL=1.0
LEAGUEPEDIA_ENRICH_BATCH_SIZE=10
LEAGUEPEDIA_GIVE_UP_AFTER_DAYS=7
